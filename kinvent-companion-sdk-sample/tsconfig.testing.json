{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "composite": false,
    "useDefineForClassFields": false,
    "noUncheckedIndexedAccess": false,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": "dist-testing",
    "tsBuildInfoFile": "dist-testing/tsconfig.testing.tsbuildinfo"
  },
  "include": [
    "testing/**/*.ts",
    "src/**/*.ts"
  ]
}
